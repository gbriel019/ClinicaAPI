<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <springProperty
            name="LOG_FILE"
            source="logging.file.name"
            defaultValue="logs/api-clinica.log"/>

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_FILE}</file>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] [id = %X{id}] %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <logger name="com.clinica.api" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

</configuration>